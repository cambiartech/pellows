# Copy to .env.local for local dev
DATABASE_URL="postgresql://pellows:pellows@127.0.0.1:5433/pellows"
DIRECT_URL="postgresql://pellows:pellows@127.0.0.1:5433/pellows"

# Public app URL (use HTTPS tunnel for WhatsApp webhooks)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# Floating WhatsApp click-to-chat widget (digits only, country code, no +)
# NEXT_PUBLIC_WHATSAPP_NUMBER="2348012345678"

# ——— Card rail (Stripe preferred if you already have it) ———
CARD_RAIL_PROVIDER="stripe"
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
# Optional client use; Checkout mainly needs secret key server-side
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Optional Nigeria alternative:
# CARD_RAIL_PROVIDER="paystack"
# PAYSTACK_SECRET_KEY=""

# ——— Bank rail ———
BANK_RAIL_BANK_NAME="Pellows Settlement"
BANK_RAIL_ACCOUNT_NAME="Pellows Limited"
BANK_RAIL_ACCOUNT_NUMBER=""

# ——— Crypto rail ———
CRYPTO_DEFAULT_ASSET="USDT"
CRYPTO_DEPOSIT_ADDRESS=""

# ——— WhatsApp Cloud API (Meta) ———
WHATSAPP_VERIFY_TOKEN="pellows-dev-verify"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# ——— Agent LLM (optional — Meta Muse preferred) ———
# https://dev.meta.ai/docs/quickstart
MODEL_API_KEY=""
MODEL_API_MODEL="muse-spark-1.3"
PELLOWS_USE_LLM="0"
# Fallback:
# OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o-mini"

# ——— Ops ———
LLM_CHANNEL_SECRET="dev-llm-secret"
CRON_SECRET="dev-cron-secret"
ADMIN_SECRET="dev-admin-secret"

